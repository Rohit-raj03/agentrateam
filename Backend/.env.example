PORT=5050
NODE_ENV=development
CLIENT_URL=https://app.vercel.app
LOCAL_CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/agentrazira

# Authentication Secrets
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_here
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_here
ACCESS_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=7d

# ImageKit Configuration (from https://imagekit.io/dashboard/developer/api-keys)
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Upload Constraints
MAX_FILE_SIZE_BYTES=5242880

# Frontend URLs are configured via CLIENT_URL and LOCAL_CLIENT_URL above

# SMTP & Email Service Configuration (Gmail SMTP or any standard SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here
# Optional legacy aliases supported:
# SMTP_EMAIL=your_email@gmail.com
# SMTP_APP_PASSWORD=your_app_specific_password_here

# Employee Invitation Expiration (in hours, default: 48)
INVITATION_EXPIRY_HOURS=48


